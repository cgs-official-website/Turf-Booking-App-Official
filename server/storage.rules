rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Public turf and avatar images
    match /turfs/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /users/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // KYC Documents (Private, accessible only by Super Admin or via server signed URLs)
    match /kyc/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
