# Server Port & Environment
PORT=5000
NODE_ENV=development

# PostgreSQL Database (Railway)
DATABASE_URL=postgresql://postgres:password@host:port/railway

# Razorpay Credentials & Webhook Secret
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Unified JWT Secret for session tokens (users, vendors, admins)
JWT_SECRET=your_long_random_jwt_secret_key_minimum_32_characters

# MSG91 SMS OTP Configuration (DLT-Approved Template)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_template_id
MSG91_SENDER_ID=TURFBK

# Nodemailer Email OTP Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="Turf Booking App <no-reply@turfbookingapp.com>"

# Redis Cache & Rate Limiting (Railway Redis URL)
REDIS_URL=redis://default:your_password@your_railway_redis_host:6379
REDIS_TLS=false
